# Required. Register a free account at https://opensky-network.org, then go
# to Account -> API Client and create an OAuth2 client. No credit card needed.
OPENSKY_CLIENT_ID=your-opensky-client-id

# Required. Shown once alongside OPENSKY_CLIENT_ID at the same screen
# (https://opensky-network.org -> Account -> API Client). No credit card needed.
OPENSKY_CLIENT_SECRET=your-opensky-client-secret

# Required. Sign in with a Google account at https://aistudio.google.com/apikey
# and create an API key. Free tier, no credit card needed.
GOOGLE_GENERATIVE_AI_API_KEY=your-google-ai-studio-api-key

# Optional. Any Gemini model id served by Google AI Studio. Defaults to
# gemini-2.5-flash if omitted.
GOOGLE_GENERATIVE_AI_MODEL=gemini-2.5-flash

# Optional. One of: debug, info, warn, error. Defaults to info if omitted.
LOG_LEVEL=info
